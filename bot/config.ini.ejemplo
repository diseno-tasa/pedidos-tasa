; ============================================================
;  Bot de reservas — Pedidos de Material · Astillero TASA
;  Copie este archivo como  config.ini  y complete los datos.
;  Las líneas que empiezan con ; son comentarios.
; ============================================================

[firebase]
; Mismos datos que config.js de la app
api_key    = AIzaSyCrVwkOyKCFku-Gu8CsGY_JIirgPb-2-RE
project_id = pedidos-tasa
dominio    = pedidos-tasa.app
; Usuario creado en la app (Gestión → Usuarios) con rol Planificador
usuario    = bot
clave      = ESCRIBA_AQUI_LA_CLAVE

[carpetas]
; Carpeta(s) donde están las carpetas de los proyectos. {año} = año actual,
; {año_anterior} = año pasado. Separe varias con ;
raices   = Z:\Diseño\RESERVAS\Reservas\{año} ; Z:\Diseño\RESERVAS\Reservas\{año_anterior}
; Qué solicitudes se automatizan, según el SISTEMA elegido en la app (ACHIQUE, TUBERIAS…).
;   *  = todas.  Para limitar: ACHIQUE, AGUAS SERVIDAS, TUBERIAS
sistemas = *
; Carpeta de especialidad dentro de cada proyecto donde se dejan los Excel
; (se reconoce aunque tenga número: "2. TUBERIAS").
carpeta_especialidad = TUBERIAS
subcarpeta_solicitados = Solicitados
subcarpeta_reservados  = Reservados
; Ejecutable que carga en SAP:
;  - un patrón (C*digo_reserva*.exe) = usa el .exe que está dentro de cada carpeta TUBERIAS
;  - una ruta completa (C:\Reservatron\Reservatron.exe) = una sola instalación para todos los proyectos
;    (recomendado, compilada con --onedir): el bot le indica la carpeta con --carpeta
ejecutable = C*digo_reserva*.exe

[proceso]
; Cada cuántos minutos revisa
intervalo_minutos = 15
; si / no
exportar        = si
; si = el bot ejecuta el Reservatron (versión con --auto) en la carpeta donde dejó Excel.
; Requiere SAP abierto y con sesión iniciada en esta PC, y la pantalla sin bloquear.
ejecutar_exe    = no
; Código del operador SAP que firma el texto explicativo (AIDROGO, HCUELLAR, LMONTENEGRO, GMUNOZ, ONAVARRO)
operador_sap = AIDROGO
; Minutos que el Reservatron espera respuesta cuando suena la sirena (luego omite ese archivo)
espera_respuesta_minutos = 10
; Cada cuántos minutos reintentar archivos del bot que quedaron en Solicitados (0 = no reintentar)
reintentar_minutos = 60
leer_reservados = si
tiempo_max_exe_minutos = 60
; Solo lee Excel de Reservados modificados desde esta fecha (AAAA-MM-DD HH:MM).
; Vacío = desde el primer arranque del bot (no toca lo histórico).
procesar_desde =
; si = no escribe nada, solo muestra lo que haría (para la primera prueba)
modo_prueba = no
zona_horaria = -5

[carpeta_por_sistema]
; Solo si algún sistema debe ir a OTRA carpeta de especialidad.
; Sistema en la app = Carpeta
; CASCO = CALDERERIA Y SOLDADURA

[alias_proyectos]
; Solo si el nombre de la carpeta no se parece al de la app.
; (RM y REM ya se reconocen como iguales: "RM HERCULES 1" = "REM HERCULES 1")
; Nombre en la app = Nombre de la carpeta
; EP TASA 218 = E.P. TASA 218

[red]
; Solo si la red de la empresa usa proxy, ej.: http://proxy.tasa.com.pe:8080
proxy =
